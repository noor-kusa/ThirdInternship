{
  "manifest_version": 3,
  "name": "AI Autocomplete",
  "version": "1.0",
  "description": "AI autocomplete on every website",
  "permissions": ["activeTab"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}